# Operating-system files
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Editor and IDE files
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
*.swo
*~

# Claude Code local/session state
.claude/scheduled_tasks.lock
.claude/.cache/

# Environment files and local secrets
.env
.env.*
!.env.example
!.env*.example
*.local
*.local.json
*.local.yaml
*.local.yml
*.pem
*.key

# JavaScript/TypeScript dependencies and build output
node_modules/
dist/
build/
coverage/
.vite/
.next/
.nuxt/
.turbo/
.parcel-cache/
.cache/

# Python tooling (for future parser utilities)
