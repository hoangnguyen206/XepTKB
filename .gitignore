*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
env/

# Logs and package-manager debug output
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Temporary files and local databases
.tmp/
tmp/
temp/
*.tmp
*.bak
*.sqlite
*.sqlite3
*.db

# Private/raw data and generated local artifacts
/data/raw/
/data/private/
/fixtures/raw/
/fixtures/private/
/uploads/
/quarantine/
/artifacts/local/
